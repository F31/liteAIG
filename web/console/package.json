{
  "name": "@liteaig/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && go build -o e2e/.bin/liteaig-e2e github.com/F31/liteAIG/cmd/liteaig && playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"scripts/*.mjs\" \"e2e/**/*.ts\" \"*.{json,ts}\"",
    "check:i18n": "node scripts/check-locales.mjs",
    "check:strings": "node scripts/check-hardcoded.mjs",
    "check": "npm run format:check && npm run check:i18n && npm run check:strings && npm test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.1",
    "@tanstack/react-query": "5.85.5",
    "antd": "5.27.1",
    "i18next": "25.4.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "react-i18next": "15.7.3",
    "react-router-dom": "7.18.3",
    "zod": "4.1.5",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "prettier": "^3.6.2",
    "tldts": "^6.1.86",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
