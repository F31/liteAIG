{
  "name": "@liteaig/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && go build -o e2e/.bin/liteaig-e2e github.com/F31/liteAIG/cmd/liteaig && playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"scripts/*.mjs\" \"e2e/**/*.ts\" \"*.{json,ts}\"",
    "check:i18n": "node scripts/check-locales.mjs",
    "check:strings": "node scripts/check-hardcoded.mjs",
    "check": "npm run format:check && npm run check:i18n && npm run check:strings && npm test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.3",
    "antd": "6.6.6",
    "i18next": "26.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.0.18",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "tldts": "^7.4.18",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
